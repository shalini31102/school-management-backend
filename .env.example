# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development           # development | production

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/school_management
# Production example:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/school_management

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_minimum_32_characters
JWT_EXPIRE=24h

JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret_minimum_32_characters
JWT_REFRESH_EXPIRE=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# For development: * (allow all). For production: set to your app's origin.
CORS_ORIGIN=*

# Used by Socket.IO CORS and can be used to restrict origins in production
CLIENT_URL=*

# ─── Groq AI (powers free-period task suggestions via llama-3.3-70b-versatile) ─
# Get your key at: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here
